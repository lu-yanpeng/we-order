# 小程序端构建变量示例：复制为 .env.local（已 gitignore）后按需修改。
# 变量在构建时注入（见 src/api/auth/config.ts），不在运行时可改。

# Supabase 项目地址。本地栈：supabase start 后的 API URL；
# 真机联调：改成手机可访问的主机地址（本地栈需额外做端口转发）。
VITE_SUPABASE_URL=http://127.0.0.1:54321

# 发布密钥（公开；权限完全由数据访问策略决定）。
# 本地取 `supabase status -o env` 的 ANON_KEY（或 PUBLISHABLE_KEY）；云端取项目设置里的发布密钥。
# 注意：服务端密钥与微信 AppSecret 不得出现在客户端（AD-16）。
VITE_SUPABASE_PUBLISHABLE_KEY=
